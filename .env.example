# Copia este archivo a .env y ajusta los valores.
# docker compose lo lee automáticamente; .env está en .gitignore.

# ─────────────────────────────────────────────────── base de datos
MSSQL_SA_PASSWORD=CambiaEstaPassword123!

# ─────────────────────────────────────────────────────────── API
# Clave de firma del JWT. Mínimo 32 caracteres; la API no arranca si falta.
# Genera una con: openssl rand -base64 48
JWT_KEY=

# Swagger queda en http://localhost:8080/swagger. Ponlo en false en producción.
SWAGGER_ENABLED=true

# Orígenes CORS extra, separados por ';'. Normalmente va vacío: el frontend
# llega por el proxy de nginx en el mismo origen y no cruza de origen.
CORS_ALLOWED_ORIGINS=

# ────────────────────────────────────── administrador inicial
# Sólo se usa la primera vez, si la base no tiene ningún administrador.
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@stockhex.local
SEED_ADMIN_PASSWORD=

# ────────────────────────────────────────────────────── frontend
# Puerto en el que queda toda la aplicación.
WEB_PORT=8080

# Déjalo vacío salvo que el navegador deba pegarle a una API en otro dominio
# en lugar de pasar por el proxy.
WEB_API_URL=

# --- Datos de demostración (sólo local) ---
# Con "true", el primer arranque siembra catálogo, clientes, usuarios de prueba y
# tres meses de movimientos, para poder recorrer la aplicación con contenido real.
# Los usuarios sembrados entran con la contraseña Demo1234.
# Para volver a una base vacía: docker compose down -v
SEED_DEMO_DATA=false
