{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "StockHexAPI",
    "Audience": "StockHexClient",
    "Key": "",
    "AccessTokenMinutes": 60
  },
  "Swagger": {
    "Enabled": false
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "TrustAllProxies": false
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": true,
    "MigrationTimeoutSeconds": 60
  },
  "RefreshTokenCleanup": {
    "Enabled": true,
    "IntervalHours": 24,
    "RetentionDays": 30
  },
  "Seed": {
    "AdminName": "",
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "AllowedHosts": "*"
}
